# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# --- LLM -----------------------------------------------------------------
# Leave empty to run the deterministic offline planner (no LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# auto = use Claude when a key is present, otherwise offline
LLM_PROVIDER=auto

# --- Integrations --------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=
AIRFLOW_JWT_SECRET=
# Kubernetes uses your kubeconfig; optionally pin a context:
KUBE_CONTEXT=docker-desktop

# --- Agent API -----------------------------------------------------------
# If set, every /api route requires header X-API-Key
AGENT_API_KEY=
TOOL_TIMEOUT_S=20
LOG_LEVEL=INFO
