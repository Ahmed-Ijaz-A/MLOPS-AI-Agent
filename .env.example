# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# --- LLM -----------------------------------------------------------------
# Leave empty to run the deterministic offline planner (no LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# auto = Claude if ANTHROPIC_API_KEY is set, else the first key found below, else the offline planner
LLM_PROVIDER=auto
# Alternatives (OpenAI-compatible, free/low-cost tiers). Set ONE key; LLM_PROVIDER=auto picks it up.
# Keys: aistudio.google.com/apikey | console.mistral.ai | cloud.cerebras.ai | console.groq.com | openrouter.ai
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides for the OpenAI-compatible provider
LLM_MODEL=
LLM_BASE_URL=

# --- Integrations --------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=
AIRFLOW_JWT_SECRET=
# Kubernetes uses your kubeconfig; optionally pin a context:
KUBE_CONTEXT=docker-desktop

# --- Agent API -----------------------------------------------------------
# If set, every /api route requires header X-API-Key
AGENT_API_KEY=
TOOL_TIMEOUT_S=20
LOG_LEVEL=INFO
